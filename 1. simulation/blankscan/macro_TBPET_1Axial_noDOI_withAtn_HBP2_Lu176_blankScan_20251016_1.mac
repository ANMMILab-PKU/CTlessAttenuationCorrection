#/gate/HoffmanBrainPhantom_Brainweb/placement/setRotationAngle 0 deg

#/gate/HoffmanBrainPhantom_Brainweb/attachPhantomSD


#=====================================================
# PHYSICS
#=====================================================
/gate/physics/addPhysicsList emlivermore_polar

/gate/physics/addProcess RadioactiveDecay


#=====================================================
# INITIALISATION
#=====================================================
/gate/run/initialize



#=====================================================
# VISUALISATION
#=====================================================

#=====================================================
#   D I G I T I Z E R: DETECTOR ELECTRONIC RESPONSE
#===================================================== 
#
#	A D D E R
#
/gate/digitizer/Singles/insert						adder         # adder to sum the hits generated per crystal
#
#       R E A D O U T 
#
/gate/digitizer/Singles/insert                  	readout
/gate/digitizer/Singles/readout/setDepth			4             # depth=3, submodule (block) level

###############################################   Energy Blurring
/gate/digitizer/Singles/insert 											localBlurring
/gate/digitizer/Singles/localBlurring/chooseNewVolume 					crystal
/gate/digitizer/Singles/localBlurring/crystal/setResolution 			0.11
/gate/digitizer/Singles/localBlurring/crystal/setEnergyOfReference 	    511. keV


############################################## Energy setWindow
/gate/digitizer/Singles/insert 											thresholder
/gate/digitizer/Singles/thresholder/setThreshold						50.0 keV              # 250 keV
/gate/digitizer/Singles/insert 											upholder
/gate/digitizer/Singles/upholder/setUphold								700.0 keV              # 650 keV

###################### Time Resolution
/gate/digitizer/Singles/insert   timeResolution
/gate/digitizer/Singles/timeResolution/setTimeResolution 176.78 ps  # the measured coincidence time resolution is 250 ps


#=====================================================
#	C O I N C I D E N C E    S O R T E R
#===================================================== 
/gate/digitizer/Coincidences/setWindow	            6 ns
/gate/digitizer/Coincidences/setOffset	            0. ns
/gate/digitizer/Coincidences/MultiplesPolicy        takeAllGoods        # takeWinnerOfGoods
/gate/digitizer/Coincidences/minSectorDifference    3
/gate/digitizer/Coincidences/describe


