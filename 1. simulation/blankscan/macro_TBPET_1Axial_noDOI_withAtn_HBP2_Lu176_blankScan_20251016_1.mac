 #=====================================================
# VISU
#=====================================================

/vis/disable
  
#/vis/open OGLSX
#/vis/drawVolume
#/vis/viewer/flush
#/tracking/storeTrajectory 0
#/vis/scene/add/trajectories
#/vis/scene/endOfEventAction accumulate
## /vis/scene/add/axes
#/vis/viewer/set/viewpointThetaPhi 0 0
#/vis/viewer/zoom 1.5

#=====================================================
# GEOMETRY
#=====================================================
/gate/geometry/setMaterialDatabase   /share/home/xzhao/workDir/simulation/data/GateMaterials_newLYSO.db

# LYSO_TB:   d=7.1 g/cm3; n=4 ; state=Solid
#         +el: name=Lutetium ;  f=0.714467891
#         +el: name=Yttrium ;   f=0.04033805
#         +el: name=Silicon;    f=0.063714272
#         +el: name=Oxygen;     f=0.181479788

#
#     W O R L D
#
/gate/world/geometry/setXLength       900. mm
/gate/world/geometry/setYLength       900. mm
/gate/world/geometry/setZLength       300. mm




#-------------------oooooOOOOO00000OOOOOooooo---------------------#
#                                                                 #
#     D E F I N I T I O N   A N D   D E S C R I T I O N           #
#        O F   Y O U R   P E T   D E V I C E                      #
#                                                                 #
#-------------------oooooOOOOO00000OOOOOooooo---------------------#

#	Define a pet system - PETscanner
/gate/world/daughters/name				        PETscanner
/gate/world/daughters/insert				    cylinder
/gate/PETscanner/setMaterial		    	    Water
/gate/PETscanner/geometry/setRmax			    440.9 mm # Rmax mm 430.9
/gate/PETscanner/geometry/setRmin			    410.9 mm # Rmin mm # 821.8/2=410.9 mm
/gate/PETscanner/geometry/setHeight			    300 mm
/gate/PETscanner/vis/setVisible                 0
#/gate/PETscanner/vis/forceWireframe                                        # draw object in WireFrame Mode
#/gate/PETscanner/vis/setColor			        red                         # define object color

#	Level1 - RSector [1 rsector = 1 * 1 modules (trans * axial or Y * Z)]
/gate/PETscanner/daughters/name			        rsector
/gate/PETscanner/daughters/insert			    box
/gate/rsector/placement/setTranslation			420.9 0.0 0.0 mm     # Rmin (half-trans FOV) + crystal_depth/2 (crystal center offset)    410.9 + 20/2 = 420.9
/gate/rsector/geometry/setXLength			    20 mm                     # depth direction of crystal
/gate/rsector/geometry/setYLength			    112.33 mm           # trans_module_size = 112.3 mm
/gate/rsector/geometry/setZLength			    300 mm             # axial_module_size = 280.6 mm
/gate/rsector/setMaterial				        Water
/gate/rsector/vis/setVisible                    1
#/gate/rsector/vis/forceWireframe
/gate/rsector/vis/setColor				        red

#	Level2 - Module (Panel) [1 module = 6 * 12 submodules (trans * axial or Y * Z)]
/gate/rsector/daughters/name				    module
/gate/rsector/daughters/insert				    box
/gate/module/geometry/setXLength			    20 mm                     # depth direction of crystal
/gate/module/geometry/setYLength			    112.33 mm             
/gate/module/geometry/setZLength			    280.6 mm 
/gate/module/setMaterial				        Water
/gate/module/vis/setVisible                     1
/gate/module/vis/forceSolid
/gate/module/vis/setColor				        green

#	Level3 - submodule  [1 submodule = 8 * 10 crystals (trans * axial or Y * Z)]
/gate/module/daughters/name				        submodule                   
/gate/module/daughters/insert				    box
/gate/submodule/geometry/setXLength			    20 mm                     # depth direction of crystal
/gate/submodule/geometry/setYLength			    112.33 mm     
/gate/submodule/geometry/setZLength			    69.162 mm     
/gate/submodule/setMaterial				        Water
/gate/submodule/vis/setVisible                  1
/gate/submodule/vis/forceWireframe
/gate/submodule/vis/setColor				    yellow

#	Level4 - block 
/gate/submodule/daughters/name				        block                   
/gate/submodule/daughters/insert				    box
/gate/block/geometry/setXLength			            20 mm                     # depth direction of crystal
/gate/block/geometry/setYLength			            18.2 mm     
/gate/block/geometry/setZLength			            22.7 mm    
/gate/block/setMaterial				                Water
# /gate/block/vis/setVisible                          1
/gate/block/vis/forceWireframe
/gate/block/vis/setColor				            white

#	Level5 - Crystal Material Layer
/gate/block/daughters/name				        crystal
/gate/block/daughters/insert				    box
/gate/crystal/placement/setTranslation	        0.0 0.0 0.0 mm
/gate/crystal/geometry/setXLength			    20 mm
/gate/crystal/geometry/setYLength			    2.05 mm
/gate/crystal/geometry/setZLength			    2.05 mm
/gate/crystal/setMaterial				        LYSO_TB
# /gate/crystal/vis/setVisible                    1                       
/gate/crystal/vis/forceSolid   
/gate/crystal/vis/setColor				        gray


##########################################################
#	Repeat the crystals, submodule, module, and rsector #
##########################################################
# Repeat Crystal
/gate/crystal/repeaters/insert				    cubicArray
/gate/crystal/cubicArray/setRepeatNumberX		1
/gate/crystal/cubicArray/setRepeatNumberY		8
/gate/crystal/cubicArray/setRepeatNumberZ		10
/gate/crystal/cubicArray/setRepeatVector		0.0 2.25 2.25 mm              # cyrstal size 2.05mm, crystal gap 0.2mm.    2.25 = 2.05+0.2     

# Repeat block 
/gate/block/repeaters/insert			    cubicArray
/gate/block/cubicArray/setRepeatNumberX		1
/gate/block/cubicArray/setRepeatNumberY		6
/gate/block/cubicArray/setRepeatNumberZ		3
/gate/block/cubicArray/setRepeatVector		0.0 18.73 23.231 mm           # block size with edge [trans 18.2mm / axial 22.7mm], block gap [trans 0.53mm / axial 0.531mm]     18.2+0.53=18.73, 22.7+0.531=23.231

# Repeat Submodule 
/gate/submodule/repeaters/insert			    cubicArray
/gate/submodule/cubicArray/setRepeatNumberX		1
/gate/submodule/cubicArray/setRepeatNumberY		1
/gate/submodule/cubicArray/setRepeatNumberZ		4
/gate/submodule/cubicArray/setRepeatVector		0.0 113.328 70.16 mm       # submodule size with edge [trans 112.33 mm / axial 69.162 mm], submodule gap 0.998mm     112.33+0.998=113.328, 69.162+0.998=70.16

# Repeat Module 
/gate/module/repeaters/insert                   cubicArray
/gate/module/cubicArray/setRepeatNumberX        1
/gate/module/cubicArray/setRepeatNumberY        1
/gate/module/cubicArray/setRepeatNumberZ        1
/gate/module/cubicArray/setRepeatVector         0.0 0.0 285.6 mm           # module size with edge [trans 112.33 mm / axial 69.162 mm], module gap 0.998mm        280.6+5 = 285.6


# Repeat RSector
/gate/rsector/repeaters/insert				    ring
/gate/rsector/ring/setRepeatNumber			    22

######################
#	Attach System #
######################
# Attach the volumes to the system tree
/gate/systems/PETscanner/level1/attach		rsector
/gate/systems/PETscanner/level2/attach		module
/gate/systems/PETscanner/level3/attach    submodule
/gate/systems/PETscanner/level4/attach		block
/gate/systems/PETscanner/level5/attach		crystal

# Definition of the sensitive detector
/gate/crystal/attachCrystalSD

# Verbosity
/gate/systems/PETscanner/describe


#=====================================================
#  P H A N T O M
#=====================================================


#/gate/world/daughters/name    HoffmanBrainPhantom_Brainweb
#/gate/world/daughters/insert  ImageRegularParametrisedVolume

#/gate/HoffmanBrainPhantom_Brainweb/geometry/SetImage /share/home/xzhao/workDir/simulation/data/muMap_cropped.h33
#/gate/HoffmanBrainPhantom_Brainweb/geometry/setRangeToMaterialFile /share/home/xzhao/workDir/simulation/data/RangeAttenuation.dat

#/gate/HoffmanBrainPhantom_Brainweb/placement/setTranslation  0. 0. 0. mm
