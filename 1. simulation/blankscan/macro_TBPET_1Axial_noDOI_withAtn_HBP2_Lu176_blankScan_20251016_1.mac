# THE FOLLOWING LINES CHARACTERIZE THE SIZE (NO DIFFERENCE WITH AN ANALYTICAL SOURCE)
#/gate/source/HoffmanBrainSource_Brainweb/setType                          backtoback
#/gate/source/HoffmanBrainSource_Brainweb/gps/particle                     gamma
#/gate/source/HoffmanBrainSource_Brainweb/gps/energytype                   Mono
#/gate/source/HoffmanBrainSource_Brainweb/gps/ene/mono                     0.511 MeV

#/gate/source/HoffmanBrainSource_Brainweb/gps/angtype iso
#/gate/source/HoffmanBrainSource_Brainweb/gps/mintheta 0. deg
#/gate/source/HoffmanBrainSource_Brainweb/gps/maxtheta 90. deg
#/gate/source/HoffmanBrainSource_Brainweb/gps/minphi 0. deg
#/gate/source/HoffmanBrainSource_Brainweb/gps/maxphi 360. deg
#/gate/source/HoffmanBrainSource_Brainweb/gps/confine NULL

#/gate/source/HoffmanBrainSource_Brainweb/visualize 100 red 3


# Lu176 INTRINSIC RADIATION
/gate/source/addSource                                      Scintillator
/gate/source/Scintillator/setActivity                       2811815.424 becquerel            # 总活度就是设置的值，平均分配到confine的体积内     264 Bq/cm3
/gate/source/Scintillator/gps/particle                      ion
/gate/source/Scintillator/gps/ion                           71 176 0 0
/gate/source/Scintillator/setForcedHalfLife                 1198700000000000000 s

/gate/source/Scintillator/setForcedUnstableFlag             true
/gate/source/Scintillator/gps/type                          Volume

/gate/source/Scintillator/gps/shape                         Cylinder
/gate/source/Scintillator/gps/radius                        450 mm
/gate/source/Scintillator/gps/halfz                         150 mm

/gate/source/Scintillator/gps/angtype                       iso
/gate/source/Scintillator/gps/centre                        0.0 0.0 0.0 mm

/gate/source/Scintillator/gps/confine                       crystal                   # confine之后会求源和crystal体积的交集

/gate/source/Scintillator/visualize                         5000 green 2

# (2.05*2.05*20) * (8*10*6*3*1*4*1*22) * 264/1000  = 84.05 * 126720 * 0.264 = 2811815.424
            
#=====================================================
#  D A T A   O U T P U T   
#=====================================================

/gate/output/root/enable
/gate/output/root/setFileName                         /data/zhaoxin/output_TBPET_1axial/TBPET_1axial_6p3p4_noDOI_Lu176_blankScan_5000s_20251016_1_
/gate/output/root/setRootHitFlag                0
/gate/output/root/setRootSinglesFlag            1
/gate/output/root/setRootCoincidencesFlag       0
#/gate/output/root/setRootSinglesAdderFlag              1
#/gate/output/root/setRootSinglesReadoutFlag     1

/gate/verbose Physic    0
/gate/verbose Cuts      0
/gate/verbose SD        0
/gate/verbose Actions   0
/gate/verbose Actor     0
/gate/verbose Step      0
/gate/verbose Error     0
/gate/verbose Warning   0
/gate/verbose Output    0
/gate/verbose Beam      0
/gate/verbose Volume    0
/gate/verbose Image     0
/gate/verbose Geometry	0
/gate/verbose Core      0

/run/verbose 		1
/event/verbose 		0
/tracking/verbose	0      



#====================================================
#  R A N D O M   E N G I N E  A N D  S E E D
#====================================================
/gate/random/setEngineName      MersenneTwister
/gate/random/setEngineSeed     11111
/gate/random/verbose            1




#=====================================================
#   M E A S U R E M E N T   S E T T I N G S   
#=====================================================
/gate/application/setTimeSlice  5000  s
/gate/application/setTimeStart  0. s
/gate/application/setTimeStop   5000  s

#
# LET'S RUN THE SIMULATION!
#
/gate/application/startDAQ

